{
  "bar": {
    "background": "opaque",
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "cities": [
            {
              "name": "Kolkata",
              "zone": "Asia/Kolkata"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            }
          ],
          "id": "omarchy.elsewhen"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/dell-stock",
          "interval": 900,
          "onClick": "xdg-open https://finance.yahoo.com/quote/DELL",
          "tooltip": "Dell Technologies (NYSE: DELL)",
          "keepSpace": true
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "dock": {
    "pinned": [
      "chromium",
      "foot",
      "YouTube",
      "emacs"
    ],
    "position": "bottom"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}