{
  "version": 1,
  "idle": {
    "screensaver": 1800,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "height": 54,
    "font-size": 22,
    "icon-size": 28,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "dell",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/dell-stock",
          "interval": 900,
          "tooltip": "Dell Technologies (NYSE: DELL)"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "jana.menu"
  ]
}
